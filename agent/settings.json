{
  "lastChangelogVersion": "1.0.4",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:@tintinweb/pi-tasks",
    {
      "source": "git:github.com/edxeth/pi-gpt-config",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:cc-safety-net",
    "npm:@ogulcancelik/pi-herdr",
    "npm:pi-add-dir",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-cc-extensions",
    "npm:@narumitw/pi-usage",
    "npm:@zigai/pi-mention-skill",
    {
      "source": "git:github.com/Dolliwyx/pi-subagents@feat/collapse-viewer-results",
      "extensions": [
        "-src/index.ts"
      ]
    },
    "../../Code/others/pi-subagents"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna"
  ],
  "editorPaddingX": 2,
  "collapseChangelog": false,
  "treeFilterMode": "user-only",
  "theme": "system",
  "extensions": [
    "-extensions/minimal-tool-calls.ts",
    "-extensions/clean-codeblocks.ts",
    "-extensions/prompt-timer.ts",
    "-extensions/finish-sound.ts",
    "-extensions/codex-quota.ts",
    "-extensions/moonshot-balance.ts",
    "-extensions/notify-done.ts"
  ],
  "skills": [
    "+~/.agents/skills/prototype/SKILL.md",
    "+~/.agents/skills/improve-codebase-architecture/SKILL.md",
    "+~/.agents/skills/impeccable/SKILL.md",
    "+~/.agents/skills/handoff/SKILL.md",
    "+~/.agents/skills/grill-with-docs/SKILL.md",
    "-skills/ponytail/SKILL.md"
  ],
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "showCacheMissNotices": true,
  "subagents": {
    "disableBuiltins": true
  },
  "gptConfig": {
    "fastMode": false,
    "personality": "claude",
    "verbosity": "low",
    "summary": "auto",
    "toolDiscipline": "on",
    "showFooter": false
  },
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript",
  "enableSkillCommands": false,
  "cacheWarming": "streaming",
  "defaultProjectTrust": "ask"
}