{
  "lastChangelogVersion": "0.86.1",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:@tintinweb/pi-tasks",
    "git:github.com/edxeth/pi-gpt-config",
    "npm:cc-safety-net",
    "npm:@ogulcancelik/pi-herdr",
    "git:github.com/dolliwyx/pi-cc-tools",
    "npm:pi-add-dir",
    "npm:@tintinweb/pi-subagents",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna"
  ],
  "editorPaddingX": 2,
  "collapseChangelog": false,
  "treeFilterMode": "user-only",
  "theme": "dark",
  "extensions": [
    "-extensions/minimal-tool-calls.ts",
    "-extensions/clean-codeblocks.ts",
    "-extensions/prompt-timer.ts"
  ],
  "skills": [
    "+skills/prototype/SKILL.md",
    "+skills/improve-codebase-architecture/SKILL.md",
    "+skills/impeccable/SKILL.md",
    "+skills/handoff/SKILL.md",
    "+skills/grill-with-docs/SKILL.md",
    "-skills/ponytail/SKILL.md"
  ],
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "showCacheMissNotices": true,
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "max"
      }
    }
  },
  "gptConfig": {
    "fastMode": false,
    "personality": "claude",
    "verbosity": "low",
    "summary": "auto",
    "toolDiscipline": "on",
    "showFooter": false
  },
  "tuiMode": "fullscreen"
}