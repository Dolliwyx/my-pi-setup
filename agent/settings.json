{
  "lastChangelogVersion": "1.4.0",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question@2.14.0",
    "npm:@juicesharp/rpiv-btw@2.14.0",
    "npm:pi-web-access@0.44.0",
    "npm:@plannotator/pi-extension@0.28.29",
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:@tintinweb/pi-tasks@0.9.1",
    "npm:cc-safety-net@2.6.18",
    "npm:@ogulcancelik/pi-herdr@0.4.1",
    "git:github.com/DietrichGebert/ponytail@09c434ab73ca43761c5d8b0c5d341926c2fba710",
    "npm:pi-cc-extensions@1.0.10",
    "npm:@narumitw/pi-usage@0.68.0",
    "npm:pi-subagent-manager@1.1.0"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna"
  ],
  "editorPaddingX": 2,
  "collapseChangelog": false,
  "treeFilterMode": "user-only",
  "theme": "cc-dark",
  "extensions": [
    "-extensions/minimal-tool-calls.ts",
    "-extensions/clean-codeblocks.ts",
    "-extensions/prompt-timer.ts",
    "-extensions/finish-sound.ts",
    "-extensions/codex-quota.ts",
    "-extensions/moonshot-balance.ts",
    "-extensions/notify-done.ts"
  ],
  "skills": [
    "+~/.agents/skills/prototype/SKILL.md",
    "+~/.agents/skills/improve-codebase-architecture/SKILL.md",
    "+~/.agents/skills/impeccable/SKILL.md",
    "+~/.agents/skills/handoff/SKILL.md",
    "+~/.agents/skills/grill-with-docs/SKILL.md",
    "-skills/ponytail/SKILL.md"
  ],
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "showCacheMissNotices": true,
  "subagents": {
    "disableBuiltins": true
  },
  "gptConfig": {
    "fastMode": false,
    "personality": "claude",
    "verbosity": "low",
    "summary": "auto",
    "toolDiscipline": "on",
    "showFooter": true
  },
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "enableSkillCommands": true,
  "cacheWarming": "streaming",
  "defaultProjectTrust": "ask"
}
